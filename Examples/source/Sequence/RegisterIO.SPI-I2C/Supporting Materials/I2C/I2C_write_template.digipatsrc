//

file_format_version 1.1;
timeset I2C_Idle, I2C_SourceStartSetup, I2C_Start, I2C_Busy, I2C_Stop;

pattern I2C_write_template (CS, SCK, SDI, SDO)
{
set_loop(reg0)						I2C_Idle				X		1		1		1;
source_start(I2C_source_buffer)		-						X		1		1		1;		// Define the register address and data buffer
									I2C_SourceStartSetup	X		1		1		1;
repeatWrite:
									I2C_Start				X		1		1		1;		// Start
									I2C_Busy				X		1		1		1;		// Device address (7-bit) = 0x77
									-						X		1		1		1;
									-						X		1		1		1;
									-						X		1		0		1;
									-						X		1		1		1;
									-						X		1		1		1;
									-						X		1		1		1;
									-						X		1		0		1;		// Write instruction (SDA = 0)
									-						X		1		L		1;		// ACK
repeat(reg1), source				-						X		1		D		1;		// Register address
									-						X		1		L		1;		// ACK
repeat(reg2), source				-						X		1		D		1;		// Data
									-						X		1		L		1;		// ACK
end_loop(repeatWrite)				I2C_Stop				X		1		0		1;		// Stop
halt								I2C_Idle				X		1		1		1;
}
