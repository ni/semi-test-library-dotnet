//

file_format_version 1.1;
timeset I2C_Idle, I2C_SourceStartSetup, I2C_Start, I2C_Busy, I2C_Stop;

pattern I2C_write_template (SDI, SCK, SDO, CS)
{
set_loop(reg0)						I2C_Idle				1		1		1		X;
source_start(i2c_source_buffer)		-						1		1		1		X;		// Define the register address and data buffer
									I2C_SourceStartSetup	1		1		1		X;
repeatWrite:
									I2C_Start				1		1		1		X;		// Start
									I2C_Busy				1		1		1		X;		// Device address (7-bit) = 0x77
									-						1		1		1		X;
									-						1		1		1		X;
									-						0		1		1		X;
									-						1		1		1		X;
									-						1		1		1		X;
									-						1		1		1		X;
									-						0		1		1		X;		// Write instruction (SDA = 0)
									-						L		1		1		X;		// ACK
repeat(reg1), source				-						D		1		1		X;		// Register address byte
									-						L		1		1		X;		// ACK
repeat(reg2), source				-						D		1		1		X;		// Data byte
									-						L		1		1		X;		// ACK
end_loop(repeatWrite)				I2C_Stop				0		1		1		X;		// Stop
halt								I2C_Idle				1		1		1		X;
}
