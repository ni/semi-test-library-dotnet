
file_format_version 1.1;
timeset Idle, SourceStartSetup, Start, Busy, Stop;

pattern I2C_read_template (CS, SDI, SDO, SCK)
{
set_loop(reg0)						Idle				1		1		1		1;
capture_start(i2c_capture_buffer)	Idle				1		1		1		1;		// Define the read buffer
source_start(i2c_source_buffer)		Idle				1		1		1		1;		// Define the register addresses buffer
									SourceStartSetup	1		1		1		1;
repeatRead:
									Start				1		1		1		1;		// Start 
									Busy				1		1		1		1;		// Device address (7-bit) = 0x77
									Busy				1		1		1		1;
									Busy				1		1		1		1;
									Busy				1		0		1		1;
									Busy				1		1		1		1;
									Busy				1		1		1		1;
									Busy				1		1		1		1;
									Busy				1		0		1		1;		// Write instruction (SDA = 0)
									Busy				1		L		1		1;		// ACK
repeat(reg1), source				Busy				1		D		1		1;		// Register address byte
									Busy				1		L		1		1;		// ACK
									Start				1		1		1		1;		// Repeat Start
									Busy				1		1		1		1;		// Device address (7-bit) = 0x77
									Busy				1		1		1		1;
									Busy				1		1		1		1;
									Busy				1		0		1		1;
									Busy				1		1		1		1;
									Busy				1		1		1		1;
									Busy				1		1		1		1;
									Busy				1		1		1		1;		// Read instruction (SDA = 1)
									Busy				1		L		1		1;		// ACK
repeat(reg2), capture				Busy				1		V		1		1;		// Data byte
									Busy				1		H		1		1;		// NACK
									Stop				1		0		1		1;		// Stop
end_loop(repeatRead)				Idle				1		1		1		1;
capture_stop						Idle				1		1		1		1;
halt								Idle				1		1		1		1;		// End Pattern
}
