file_format_version 1.1;
timeset Idle, SourceStartSetup, Start, Busy, Stop;

pattern I2C_write_template (SDI, SDO, SCK)
{
set_loop(reg0)                         Idle              X       X       1;
source_start(source_buffer)            Idle              X       X       1;
                                      SourceStartSetup   X       X       1;
repeatWrite:
                                      Start              1       X       1;
                                      Busy               0       X       0;
repeat(reg1), source                 Busy              D       X       0;
repeat(reg2), source                 Busy              D       X       0;
                                      Stop               1       X       1;
end_loop(repeatWrite)                  Idle              X       X       1;
halt                                   Idle              X       X       X;
}