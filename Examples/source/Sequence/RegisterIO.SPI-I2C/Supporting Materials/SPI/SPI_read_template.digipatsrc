
file_format_version 1.1;
timeset SourceStartSetup, SPI_Busy, SPI_Stop, SPI_Idle, SPI_Start;

pattern SPI_read_template (CS, SDI, SDO, SCK)
{
set_loop(reg0)						SPI_Idle			1		X		X		1;
capture_start(spi_capture_buffer)	-					1		X		X		1;		// Define the read buffer
source_start(spi_source_buffer)		-					1		X		X		1;		// Define the register addresses buffer
									SourceStartSetup	1		X		X		1;
repeatRead:
									SPI_Start			0		X		X		1;		// Start (CS = 0)
									SPI_Busy			0		1		X		1;		// Read instruction (MOSI = 1)
repeat(reg1), source				-					0		D		X		1;		// Register address
repeat(reg2), capture				-					0		X		V		1;		// Register value
end_loop(repeatRead)				SPI_Stop			1		X		X		1;		// Stop (CS = 1)
capture_stop						SPI_Idle			1		X		X		1;
halt								-					1		X		X		1;
}
