
file_format_version 1.1;
timeset Idle, SourceStartSetup, Start, Busy, Stop;

pattern SPI_read_template (CS, SDI, SDO, SCK)
{
set_loop(reg0)						Idle				1		X		X		1;
capture_start(capture_buffer)		Idle				1		X		X		1;		// Define the read buffer
source_start(source_buffer)			Idle				1		X		X		1;		// Define the register addresses buffer
									SourceStartSetup	1		X		X		1;
repeatRead:
									Start				0		X		X		1;		// Start (CS = 0)
									Busy				0		1		X		1;		// Read instruction (MOSI = 1)
repeat(reg1), source				Busy				0		D		X		1;		// Register address
repeat(reg2), capture				Busy				0		X		V		1;		// Register value
end_loop(repeatRead)				Stop				1		X		X		1;		// Stop (CS = 1)
capture_stop						Idle				1		X		X		1;
halt								Idle				1		X		X		1;		// End Pattern
}
